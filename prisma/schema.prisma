// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String
  role         String   @default("STUDENT") // "ADMIN", "TEACHER", "STUDENT", "TU", "WALI_KELAS", "WAKA_KURIKULUM", "WAKA_KESISWAAN", "WAKA_SARPRAS", "WAKA_HUBDIN", "KEPSEK"
  avatarUrl    String?  @db.Text
  studentClass String?  // e.g. "X RPL 1"
  waliKelasOf  String?  // e.g. "X RPL 1"
  nipOrNis     String?  // NIP / NIS
  hasSmartphone Boolean @default(true) // Status kepemilikan smartphone untuk presensi
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coursesAsTeacher   Course[]                @relation("TeacherCourses")
  enrollments        Enrollment[]
  submissions        Submission[]
  dapodikForm        DapodikForm?
  examResults        ExamResult[]
  documents          StudentDocument[]
  attendances        StudentAttendance[]
  teacherAgendas     TeacherClassAgenda[]
  classSchedules     ClassTeachingSchedule[]
  correctionRequests DataCorrectionRequest[]
  activityReports    ActivityReport[]
}

model DapodikForm {
  id               String   @id @default(cuid())
  studentId        String   @unique
  // 1. Identitas
  namaLengkap      String
  jenisKelamin     String
  nisn             String
  nis              String?
  noIjazah         String?
  noUjian          String?
  nik              String
  npsnAsal         String?
  sekolahAsal      String?
  tempatLahir      String
  tanggalLahir     String
  agama            String
  berkebutuhanKhusus String?
  alamat           String
  rtRw             String?
  dusun            String?
  kelurahan        String?
  kecamatan        String?
  kabupaten        String?
  propinsi         String?
  kodePos          String?
  transportasi     String?
  jenisTinggal     String?
  noTelp           String?
  noHp             String
  emailPribadi     String?
  noKks            String?
  penerimaKps      String?
  usulanPip        String?
  penerimaKip      String?
  noKip            String?
  namaDiKip        String?
  alasanTolakKip   String?
  noAktaLahir      String?
  lintang          String?
  bujur            String?

  // 2. Data Ayah
  namaAyah         String
  tahunLahirAyah   String?
  kebutuhanAyah    String?
  pekerjaanAyah    String?
  pendidikanAyah   String?
  penghasilanAyah  String?

  // 3. Data Ibu
  namaIbu          String
  tahunLahirIbu    String?
  kebutuhanIbu     String?
  pekerjaanIbu     String?
  pendidikanIbu    String?
  penghasilanIbu   String?

  // 4. Data Wali (Opsional)
  namaWali         String?
  tahunLahirWali   String?
  pekerjaanWali    String?
  pendidikanWali   String?
  penghasilanWali  String?

  // 5. Data Periodik
  tinggiBadan      String?
  beratBadan       String?
  jarakSekolah     String?
  waktuTempuh      String?
  jmlSaudara       String?
  anakKe           String?
  citaCita         String?
  hobi             String?
  asalTkPaud       String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student          User     @relation(fields: [studentId], references: [id])
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  teacherId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     User         @relation("TeacherCourses", fields: [teacherId], references: [id])
  enrollments Enrollment[]
  lessons     Lesson[]
  exams       Exam[]
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  createdAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
}

model Lesson {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  content   String?  // HTML or Markdown content
  videoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course      Course       @relation(fields: [courseId], references: [id])
  assignments Assignment[]
}

model Assignment {
  id          String   @id @default(cuid())
  lessonId    String
  title       String
  description String?
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lesson      Lesson       @relation(fields: [lessonId], references: [id])
  submissions Submission[]
}

model Submission {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  content      String?  // Text submission
  fileUrl      String?  // File upload link
  grade        Int?     // Score given by teacher
  feedback     String?
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    User       @relation(fields: [studentId], references: [id])
}

model Exam {
  id              String       @id @default(cuid())
  courseId        String
  title           String
  description     String?
  durationMinutes Int          @default(60)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  course          Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions       Question[]
  results         ExamResult[]
}

model Question {
  id             String   @id @default(cuid())
  examId         String
  questionNumber Int
  questionText   String   // Mendukung teks biasa, KaTeX math rumus, dan Arab RTL
  imageUrl       String?  // Opsional URL gambar soal
  optionA        String
  optionB        String
  optionC        String
  optionD        String
  optionE        String?
  correctAnswer  String   // "A", "B", "C", "D", "E"

  exam           Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model ExamResult {
  id              String   @id @default(cuid())
  examId          String
  studentId       String
  score           Float
  totalCorrect    Int
  totalQuestions  Int
  answers         Json     // Catatan jawaban siswa
  violationsCount Int      @default(0) // Catatan pelanggaran keluar tab/layar ujian
  submittedAt     DateTime @default(now())

  exam            Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student         User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
}

model StudentDocument {
  id           String    @id @default(cuid())
  studentId    String
  docType      String    // "AKTE_KELAHIRAN", "KARTU_KELUARGA", "IJAZAH_SMP"
  fileName     String
  fileUrl      String    @db.Text
  fileType     String    // "application/pdf", "image/jpeg", "image/png", etc.
  fileSize     Int?
  status       String    @default("PENDING") // "PENDING", "VERIFIED", "REJECTED"
  feedback     String?   // Catatan perbaikan dari TU jika berkas ditolak
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student      User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, docType])
}

model SchoolSetting {
  id                 String   @id @default("default")
  schoolName         String   @default("SMK Nesaka")
  schoolLat          Float    @default(-6.346129)
  schoolLng          Float    @default(108.099104)
  radiusMeters       Float    @default(200.0)
  checkInStartTime   String   @default("06:30")
  checkInLateTime    String   @default("07:00")
  checkOutStartTime  String   @default("15:00")
  updatedAt          DateTime @updatedAt
}

model StudentAttendance {
  id                  String    @id @default(cuid())
  studentId           String
  date                String    // "YYYY-MM-DD"
  checkInTime         DateTime?
  checkInPhoto        String?   @db.Text
  checkInLat          Float?
  checkInLng          Float?
  checkInDistance     Float?
  checkInStatus       String?   // "HADIR", "TERLAMBAT", "IZIN", "SAKIT", "ALPA"
  checkInLateMinutes  Int       @default(0)
  checkOutTime        DateTime?
  checkOutPhoto       String?   @db.Text
  checkOutLat         Float?
  checkOutLng         Float?
  checkOutStatus      String?   // "PULANG", "BOLOS"
  notes               String?
  scannedByTuId       String?   // ID akun staf TU yang memindai kartu presensi siswa
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  student             User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
}

model Classroom {
  id           String               @id @default(cuid())
  name         String               @unique // e.g. "X RPL 1"
  code         String               @unique // Barcode/QR token, e.g. "NESAKA-X-RPL-1"
  level        String               @default("10")
  createdAt    DateTime             @default(now())

  agendas      TeacherClassAgenda[]
  schedules    ClassTeachingSchedule[]
}

model ClassTeachingSchedule {
  id          String   @id @default(cuid())
  teacherId   String
  classroomId String
  subject     String
  dayOfWeek   Int
  startTime   String
  endTime     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher    User                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classroom  Classroom           @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  agendas    TeacherClassAgenda[]

  @@index([teacherId, dayOfWeek, isActive])
  @@index([classroomId, dayOfWeek, isActive])
}

model TeacherClassAgenda {
  id                  String    @id @default(cuid())
  teacherId           String
  classroomId         String
  classScheduleId     String?
  subject             String
  scheduledStartTime  String    // e.g. "07:30"
  scheduledEndTime    String    // e.g. "09:30"
  scanTime            DateTime  @default(now())
  isLate              Boolean   @default(false)
  lateMinutes         Int       @default(0)
  teachingMaterial    String    @db.Text
  notes               String?   @db.Text
  date                String    // "YYYY-MM-DD"
  createdAt           DateTime  @default(now())

  teacher             User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classroom           Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  classSchedule       ClassTeachingSchedule? @relation(fields: [classScheduleId], references: [id], onDelete: SetNull)

  @@unique([classScheduleId, date])
}

model DataCorrectionRequest {
  id             String    @id @default(cuid())
  studentId      String
  status         String    @default("PENDING") // "PENDING", "PROCESSED", "REJECTED"
  notes          String    @db.Text
  adminResponse  String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model ActivityReport {
  id                String    @id @default(cuid())
  authorId          String
  roleSource        String    // "WAKA_KURIKULUM", "WAKA_KESISWAAN", "WAKA_SARPRAS", "WAKA_HUBDIN"
  title             String
  date              DateTime  @default(now())
  location          String?
  description       String    @db.Text
  documentationUrl  String?   @db.Text
  participants      String?   @db.Text
  status            String    @default("COMPLETED")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  author            User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

