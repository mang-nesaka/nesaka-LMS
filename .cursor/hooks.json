{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/auto-commit-push.sh",
        "timeout": 120
      }
    ],
    "afterTabFileEdit": [
      {
        "command": ".cursor/hooks/auto-commit-push.sh",
        "timeout": 120
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/auto-commit-push.sh --now",
        "timeout": 120
      }
    ]
  }
}
